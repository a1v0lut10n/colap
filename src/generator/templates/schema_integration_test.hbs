#[test]
fn the_sample_loads_through_the_schema() {
    let root = Root::load("{{document}}").unwrap_or_else(|errors| {
        let text: Vec<String> = errors.iter().map(|e| e.to_string()).collect();
        panic!("{}", text.join("\n"))
    });
    let _ = format!("{root:?}");
    assert_eq!(root, root.clone());
}
