use {{sanitized_crate_name}}::Root;
{{#each plural_entity_types}}
use {{../sanitized_crate_name}}::{{this}};
{{/each}}
{{else}}
use crate::Root;
{{#each plural_entity_types}}
use crate::{{this}};
{{/each}}
