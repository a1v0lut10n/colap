    }

    /// Read a file, validate it against [`SCHEMA`] and build the root,
    /// or every error found.
    pub fn load(path: impl AsRef<std::path::Path>) -> Result<Self, Vec<colap::Diagnostic>> {
        let schema = colap::check_str(SCHEMA, None)
            .outcome
            .ok()
            .and_then(|model| colap::load_schema(&model, None).schema);
        let mut report = colap::check_file(path.as_ref());
        match &schema {
            Some(schema) => report.validate(schema),
            None => {
                return Err(vec![colap::Diagnostic::at(
                    colap::diagnostic::Severity::Error,
                    None,
                    None,
                    "the embedded schema does not load; regenerate this code".into(),
                )]);
            }
        }
        if !report.is_clean() {
            return Err(report
                .diagnostics()
                .into_iter()
                .filter(|d| d.severity == colap::diagnostic::Severity::Error)
                .collect());
        }
        match report.outcome {
            Ok(model) => Ok(Self::from_model(&model)),
            Err(error) => Err(colap::Diagnostic::from_error(&error)),
        }
    }

