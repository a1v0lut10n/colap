// The cola language proper. Markdown is not this grammar's business:
// `src/literate.rs` finds the fenced blocks and hands only the bodies
// of the ```cola ones here, so prose outside fences is unconstrained.

Cola: Entity*;

Entity: PluralEntity | SingularEntity;

PluralEntity: Identifier PluralKeyword Identifier Colon EntityDefinition Semicolon;
SingularEntity: Identifier Colon EntityDefinition Semicolon;

// A definition interleaves fields and nested entities. The comma that
// separates fields belongs to the field before it, so a trailing comma
// before `;` or before a nested entity costs nothing: after a comma an
// identifier is always shifted, and the parser stays LR(1). The
// repetitions are vectors, not left-recursive chains, so a block of
// thousands of entries builds no deep AST.
EntityDefinition: Item*;

Item: Field | Field Comma | Entity;

Field: Identifier Colon FieldValue;

FieldValue: Scalar | List;

// An identifier in value position is a symbol.
Scalar: QuotedStringDouble | QuotedStringSingle | BlockString | Number
      | BooleanTrue | BooleanFalse | Reference | Identifier;

List: LBracket Scalar*[Comma] RBracket | LBracket Scalar+[Comma] Comma RBracket;

// Layout is skipped between any two tokens: whitespace, and `//`
// comments to the end of the line, lexed as one terminal because the
// layout parser runs between every two tokens and a single regex is
// the cheapest it gets. A `//` inside a string is text, since the
// string terminal is matched first. Comments reach the model by a
// second pass over the block text (`ModelBuilder::add_block`), not
// through this grammar.
Layout: WS+ | EMPTY;

terminals
	BooleanTrue: 'true';
	BooleanFalse: 'false';
	Colon: ':';
	Comma: ',';
	LBracket: '[';
	RBracket: ']';
	Identifier: /[a-zA-Z_][a-zA-Z0-9_.-]*/;
	Number: /[+-]?[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?/;
	PluralKeyword: "plural";
	Reference: /@[a-zA-Z_][a-zA-Z0-9_.-]*(\/[a-zA-Z_][a-zA-Z0-9_.-]*)*/;
	QuotedStringDouble: /"([^"\\]|\\.)*"/;
	QuotedStringSingle: /'([^'\\]|\\.)*'/;
	BlockString: /"""(?s:.*?)"""/;
	Semicolon: ';';
	// Whitespace and comments, for the Layout rule only
	WS: /(\s+|\/\/[^\n]*)+/;
